# Azure Configuration
subscription_id = "your-subscription-id"
resource_group_name = "your-resource-group-name"
location = "westeurope"

# Existing Resources
container_app_environment_name = "your-container-app-environment-name"
log_analytics_workspace_name = "your-log-analytics-workspace-name"
application_insights_name = "your-application-insights-name"

# Container App Configuration
container_app_name = "demov1-formula-vc-demo"
acr_name = "youracrname"  # Must be globally unique, 5-50 chars, lowercase alphanumeric only (no hyphens)
container_image_name = "formula-vc-app"
container_image_tag = "latest"

# Scaling Configuration
min_replicas = 1
max_replicas = 1

# Verified ID Configuration
verified_id_tenant_id = "your-tenant-id"
verified_id_client_id = "your-client-id"
verified_id_client_secret = "your-client-secret"
verified_id_did_authority = "your-did-authority"
verified_id_credential_type = "VerifiedCredentialExpert"
verified_id_credential_manifest = "https://your-manifest-url"

# Verified ID Additional Settings
verified_id_authority = "https://login.microsoftonline.com/{tenant}/v2.0/"  # {tenant} will be replaced with tenant_id
verified_id_client_name = "DotNet Client API Verifier"
verified_id_purpose = "To prove your identity"
verified_id_include_qr_code = false
verified_id_include_receipt = true
verified_id_allow_revoked = false
verified_id_validate_linked_domain = true
verified_id_issuance_pin_code_length = 4
verified_id_use_face_check = false
verified_id_match_confidence_threshold = 70
verified_id_photo_claim_name = ""  # Leave blank if not using FaceCheck
verified_id_credential_expiration = ""  # EOD, EOW, EOQ, EOY, or "" (empty). Only valid for idTokenHint flows
verified_id_certificate_name = ""  # Alternative to ClientSecret. Leave blank to use ClientSecret

